{
  "name": "jev",
  "version": "0.3.0",
  "description": "Control your Mac by voice: fixed commands for apps, websites, keys and scrolling, matched in plain code. No model.",
  "type": "module",
  "bin": {
    "jev": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "sh native/build.sh && sh test/fixture/build.sh",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "start": "node src/cli.js"
  }
}
